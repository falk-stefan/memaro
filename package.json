{
  "name": "memaro",
  "version": "0.0.1",
  "description": "",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsoa spec-and-routes && tsx watch src/index.ts",
    "build": "tsoa spec-and-routes && tsc",
    "tsoa:spec-and-routes": "tsoa spec-and-routes",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:migrate",
    "db:migrate:undo": "ts-node -r tsconfig-paths/register ./node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
    "ingest": "tsx src/cli/ingest.ts",
    "create-api-key": "tsx src/cli/create-api-key.ts",
    "create-api-key:dev": "tsx src/cli/create-api-key.ts --org Dev --email dev@memaro.local --name Dev --label dev",
    "backfill-memory-tenant": "tsx src/cli/backfill-memory-tenant.ts",
    "check-worker-identity": "tsx src/cli/check-worker-identity.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint --fix src/",
    "pretest": "tsoa spec-and-routes",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "Stefan Falk",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@tsoa/runtime": "7.0.0-alpha.0",
    "express": "^5.2.1",
    "sequelize-typescript": "^2.1.6",
    "ts-node": "^10.9.2",
    "tsoa": "7.0.0-alpha.0",
    "tsx": "^4.21.0",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "pg": "^8.20.0",
    "prettier": "^3.9.8",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.1"
  }
}
